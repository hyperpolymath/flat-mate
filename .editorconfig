# SPDX-License-Identifier: PMPL-1.0-or-later
# flat-mate editor configuration
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.adoc]
trim_trailing_whitespace = false

# JavaScript / JSX / TypeScript
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

# CSS
[*.css]
indent_size = 2

# HTML
[*.html]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Scheme (SCM state files)
[*.scm]
indent_size = 2
