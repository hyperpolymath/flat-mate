{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "name": "@flat-mate/web",
  "version": "0.1.0",
  "license": "MPL-2.0",
  "tasks": {
    "dev": "deno run -A --node-modules-dir=auto npm:vite@^8.0.7",
    "build": "deno run -A --node-modules-dir=auto npm:vite@^8.0.7 build",
    "preview": "deno run -A --node-modules-dir=auto npm:vite@^8.0.7 preview"
  },
  "imports": {
    "react": "npm:react@^18.3.1",
    "react-dom": "npm:react-dom@^18.3.1",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.4.1",
    "vite": "npm:vite@^8.0.7"
  },
  "nodeModulesDir": "auto"
}
